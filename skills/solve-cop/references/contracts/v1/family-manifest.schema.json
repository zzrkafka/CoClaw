{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COClaw family manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "family", "status", "objective", "guide", "parser", "validator", "formats", "semantics"],
  "properties": {
    "version": {"const": 1},
    "family": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["initializing", "active", "disabled"]},
    "status_reason": {"type": "string"},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sense", "name"],
      "properties": {
        "sense": {"enum": ["min", "max"]},
        "name": {"type": "string"}
      }
    },
    "guide": {"type": "string"},
    "parser": {"type": "string"},
    "validator": {"type": "string"},
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "extensions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "rejects"],
      "properties": {
        "requires": {"type": "array", "items": {"type": "string"}},
        "rejects": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
